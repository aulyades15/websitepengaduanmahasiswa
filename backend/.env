# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pengaduan_db
DB_USER=postgres
DB_PASSWORD=postgres

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=pengaduan-mahasiswa-jwt-secret-key-2026-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=pengaduan-refresh-secret-key-2026-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Email (SMTP) - configure for production
# Gmail example: use App Password (not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@uingusdur.ac.id
EMAIL_FROM_NAME=CampusCare UIN Gus Dur

# WhatsApp Webhook (generic - works with Twilio, Fonnte, Wablas, custom)
# Set WHATSAPP_WEBHOOK_URL to your provider's send-message endpoint
# Expected POST JSON: { "to": "628xx...", "message": "..." }
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS & email links)
FRONTEND_URL=http://localhost:5173